# Copy to .env and adjust as needed.

# PostgreSQL connection string.
DATABASE_URL="postgresql://landapp:landapp_dev_pw@localhost:5432/landmarket?schema=public"

# Secret used to sign JWTs. Change this in any real deployment.
JWT_SECRET="dev-only-secret-change-me"

# Port the API server listens on.
PORT=4000

# Comma-separated list of allowed CORS origins for the client dev server.
CLIENT_ORIGIN="http://localhost:5173"

# "development" enables the mock wallet top-up endpoint and seeds test
# balances. Set to "production" to disable those dev-only affordances.
NODE_ENV="development"

# --- Social sign-in (Google / Apple / Microsoft) ---------------------------
# Leave any of these unset and that provider automatically runs in mock/dev
# mode (see server/src/lib/oauth) - the sign-in flow, account linking, and
# new-account provisioning all still work end-to-end, just without a real
# provider's signature check. Set these to enable real verification:
#
# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
#   (a "Web application" or "iOS"/"Android" client ID both work - the ID
#   token's `aud` claim is checked against this value)
# APPLE_CLIENT_ID: your Services ID from https://developer.apple.com/account/resources/identifiers
# MICROSOFT_CLIENT_ID: Application (client) ID from an App registration in
#   https://portal.azure.com (Entra ID)
# MICROSOFT_TENANT: usually "common" for a multi-tenant/consumer app;
#   set to your tenant GUID for a single-tenant app.
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_TENANT="common"
